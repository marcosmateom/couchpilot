# Generated by ./mc setup — NVIDIA NVENC hardware transcoding.
# Requires the NVIDIA Container Toolkit (see docs/hardware-transcoding.md).
services:
  jellyfin:
    environment:
      NVIDIA_VISIBLE_DEVICES: all
      NVIDIA_DRIVER_CAPABILITIES: all
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
