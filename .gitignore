# ── Secrets & machine-specific config (created by ./mc setup) ────────────────
.env
.setup-manifest

# ── Files generated by ./mc setup ────────────────────────────────────────────
compose.hwaccel.yml
compose.drives.yml
caddy/sites/*.caddy

# ── Runtime state (created by the containers on first start) ─────────────────
*/config/
pihole/
tailscale/state/
jellyfin/cache/
manga/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
