# ══════════════════════════════════════════════════════════════════════════════
# couchpilot configuration
#
# You normally never edit this by hand — run  ./mc setup  and it writes .env
# for you. This file documents every variable.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Basics (wizard-managed) ──────────────────────────────────────────────────

# Your timezone, e.g. Europe/Madrid — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# The user/group that owns your media files (run `id -u` and `id -g`)
PUID=1000
PGID=1000

# Where your media lives. The wizard creates movies/ tv/ downloads/ inside it.
DATA_DIR=~/media

# Which optional pieces run. Comma-separated, any of:
#   dns, manga, samba, tailscale, jackett, rdtclient
# e.g.  COMPOSE_PROFILES=dns,tailscale
COMPOSE_PROFILES=

# Extra compose files generated by the wizard (hardware transcoding, extra
# drives). Leave alone unless you know what you're doing.
#COMPOSE_FILE=docker-compose.yml:compose.hwaccel.yml

# ─── Optional: dns profile (Pi-hole + Unbound) ────────────────────────────────

# This machine's LAN IP — Pi-hole's DNS port binds to it
#LAN_IP=

# Pi-hole web UI password
#PIHOLE_PASSWORD=

# ─── Optional: domain mode (HTTPS via Cloudflare) ─────────────────────────────

# Your domain, e.g. example.com — see docs/domain-https.md
#DOMAIN=

# Cloudflare API token with Zone:Read + DNS:Edit for that domain
#CLOUDFLARE_API_TOKEN=

# ─── Optional: tailscale profile ──────────────────────────────────────────────

# Auth key from https://login.tailscale.com/admin/settings/keys
# (optional — leave unset and check `./mc logs tailscale` for a login URL)
#TS_AUTHKEY=

# Machine name on your tailnet
#TS_HOSTNAME=couchpilot

# ─── Optional: samba profile ──────────────────────────────────────────────────

#SAMBA_USER=
#SAMBA_PASSWORD=

# ─── Optional: manga profile (Suwayomi + Komga) ───────────────────────────────

# Where manga is stored (default: DATA_DIR/manga, set by the wizard)
#MANGA_DIR=

# Suwayomi web UI login
#SUWAYOMI_USER=
#SUWAYOMI_PASSWORD=

# ─── Backups (scripts/backup.sh) ──────────────────────────────────────────────

# Where encrypted config backups are written (ideally a different drive)
#BACKUP_DIR=

# Passphrase for the encrypted backup archives — losing it makes them useless
#BACKUP_PASSPHRASE=

# ─── Advanced (defaults are fine for almost everyone) ─────────────────────────

# Docker subnets — change only if they collide with your LAN or another stack
#MEDIA_SUBNET=172.28.0.0/24
#DNS_SUBNET=172.29.0.0/24

# Static container IPs — must live inside the subnets above
#QBIT_IP=172.28.0.50
#UNBOUND_IP=172.29.0.2
#PIHOLE_IP=172.29.0.3
